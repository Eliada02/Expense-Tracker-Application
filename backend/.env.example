# Copy to .env and fill in your own values. Never commit the real .env.

# MongoDB connection string (Atlas or local).
MONGO_URL=mongodb://127.0.0.1:27017/expense-tracker

# Port the API listens on.
PORT=5000

# Allowed frontend origin(s). Comma separated for multiple.
CLIENT_URL=http://localhost:5173

# Timezone used to bucket expenses into days/months in the dashboard.
# Set this to your own zone, e.g. Europe/Rome.
APP_TIMEZONE=UTC

# ISO 4217 currency code used for formatting.
CURRENCY=EUR

# development | production | test
NODE_ENV=development
