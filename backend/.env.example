# Copy to .env and fill in your own values. Never commit the real .env.

# MongoDB connection string (Atlas or local).
MONGO_URL=mongodb://127.0.0.1:27017/expense-tracker

# Port the API listens on.
PORT=5000

# Allowed frontend origin(s). Comma separated for multiple.
CLIENT_URL=http://localhost:5173

# Timezone used to bucket expenses into days/months in the dashboard.
# Set this to your own zone, e.g. Europe/Rome.
APP_TIMEZONE=UTC

# ISO 4217 currency code used for formatting.
CURRENCY=EUR

# development | production | test
NODE_ENV=development

# --- Authentication ---
# Secret used to sign session JWTs. Generate a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs every existing session out.
JWT_SECRET=

# How long a session lasts: 7d | 12h | 30m
JWT_EXPIRES_IN=7d

# Cookie flags. Defaults suit local development (Lax, insecure over http).
# A frontend on a different site needs COOKIE_SAMESITE=none and COOKIE_SECURE=true.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
